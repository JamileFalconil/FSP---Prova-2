	title = {Do in-group biases lead to overconfidence in performance? Experimental evidence},
	year = {2024},
	journal = {Journal of Behavioral and Experimental Economics },
	volume = {111},
	pages = {},
	doi = {10.1016/j.socec.2024.102217},
	url = {https://www.scopus.com/pages/publications/85192860457?origin=resultslist},
	affiliations = {University of Porto, Portugal; University of Exeter, United Kingdom; NIPE, Universidade do Minho, Portugal},
	abstract = {Is the phenomenon of people overestimating their skill relative to their peers (overplacement) exacerbated by group affiliation? Social identity theory predicts people evaluate in-group members more positively than out-group members, and we hypothesized that this differential treatment may result in greater overplacement when interacting with an out-group member. We tested this hypothesis with 301 US voters affiliated with either the Republican or Democratic party in the run-up to the 2020 Presidential election, a time when political identities were salient and highly polarized. We found there is a higher tendency for overplacement when faced with an out-group opponent than with an in-group opponent. Decomposition analysis suggests this difference is due to underestimating the opponent, as opposed to overestimating one's own performance to a higher degree. Moreover, any tendency to incur in overplacement is mitigated when faced with an opponent with the same political identity relative to one with a neutral one. Group affiliation biases initial priors, but not how they are updated. © 2024 The Author(s)},
	author_keywords = {Belief updating; Competition; Motivated beliefs; Overconfidence; Overplacement; Social identity},
	correspondence_address = {L.Q. Flores; University of Porto School of Economics and Management (FEP), Porto, Rua Dr. Roberto Frias., Portugal; email: up201203503@fep.up.pt},
	publisher = {Elsevier Inc.},
	issn = {22148043},
	language = {English},
	abbrev_source_title = {J. Behave. Exp. Econ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

