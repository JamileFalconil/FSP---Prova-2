	title = {Closer to election, more light: electricity supply and elections in a postconflict transition economy},
	year = {2020},
	journal = {Post-Communist Economies},
	volume = {32},
	number = {3},
	pages = {376 - 390},
	doi = {10.1080/14631377.2019.1640982},
	url = {https://www.scopus.com/pages/publications/85073812258?origin=resultslist},
	affiliations = {Faculty of Economics and Agribusiness, Agricultural University of Tirana, Tirana, Albania; CERGE–EI, Prague, Czech Republic; Ministry of Finance and Economy of Albania, Tirana, Albania; Department of Agriculture Economics, University of Prishtina, Prishtina, Serbia; Faculty of Business, Education and Law, Staffordshire University, Stoke-on-Trent, United Kingdom},
	abstract = {In our paper, we analyse the supply of electricity in conjunction with elections in Kosovo. The results confirm our hypotheses that before scheduled (regular) parliamentary elections, the supply of electricity increases significantly above usual levels, but that this is not the case for early (snap) elections. This paper contributes to the Political Business Cycle (PBC) literature in two ways. It provides additional evidence of incumbent manipulation of non-classical policy instruments before elections. The paper contributes also to the PBC debate by revealing different incumbent strategies in scheduled and early elections, respectively, thus highlighting the importance of distinguishing between these types of elections in PBC research. © 2019, © 2019 Informa UK Limited, trading as Taylor & Francis Group.},
	author_keywords = {electricity supply; Kosovo; Political business cycle},
	keywords = {Kosovo; business cycle; election; electricity supply; market transition; parliament; post-communism},
