	affiliations = {University of Kent, School of Economics, Canterbury, Kent, CT2 7NZ, United Kingdom; University of Copenhagen, Department of Economics, Øster Farimagsgade 5, building 26, Copenhagen K, 1353, Denmark; University of Southern Denmark, Department of Economics, Campusvej 55, Odense M, 5230, Denmark},
	abstract = {The reasons for the famous agrarian unrest in the United States between 1870 and 1900 remain debated. We contribute to this debate with a simple economic argument. Falling transportation costs allowed for the extension of the frontier, where farmers received the world price minus the transaction costs involved in getting their produce to market. Many considered these costs to be unfairly large, owing to the perceived market power of rail firms and the discriminatory practices of middlemen, with farmers closer to the frontier most affected. Consistent with this, we find that the protest, as measured by vote shares for the Populists in the 1892 Presidential elections, is negatively related to wheat prices, and the transportation costs to the international export hubs – New York City and Chicago. © Società editrice il Mulino.},
	author_keywords = {Agriculture; globalization; Grain Invasion; populism; United States},
	correspondence_address = {P. Sharp; University of Southern Denmark, Department of Economics, Odense M, Campusvej 55, 5230, Denmark; email: pauls@sam.sdu.dk},
	publisher = {Societa Editrice Il Mulino},
	issn = {03933415},
	language = {English},
	abbrev_source_title = {Riv. Stor. Econ.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

